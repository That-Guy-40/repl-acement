#!/usr/bin/env bash
##
##  perlrepl - a REPL for Perl
##
##  Based on awkrepl by Kevin Ernst <ernstki -at- mail.uc.edu>
##  License:  MIT
##
##  Requirements:
##    - perl ≥ 5
##    - tmux ≥ 2
##    - entr - http://eradman.com/entrproject/
##    - bat (optional) - https://github.com/sharkdp/bat
##
##  This is the punchline that awkrepl's own README set up: "the whole
##  script probably should've just been written in Perl."
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "perlrepl: error at line $LINENO" >&2; exit 1' ERR

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_perlrepl_pretty_print() {
    local src=${1:?missing perl source file argument}
    local cat='cat'

    local _bat
    _bat=$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    [[ -n "$_bat" ]] && cat="$_bat -l perl -p --tabs=4"

    [[ -s "$src" ]] && $cat "$src" 2>/dev/null
} # _perlrepl_pretty_print

# returns '-n' if the script looks like a bare per-line expression
# (i.e. it doesn't open with a block keyword or use BEGIN/END)
_perlrepl_needs_n() {
    local src=${1:?missing perl source file argument}
    [[ ! -s "$src" ]] && return 1

    # ask perl itself: inspect the first non-blank, non-comment line
    perl - "$src" <<'EOPL'
use strict;
my $file = $ARGV[0];
open my $fh, '<', $file or die "cannot open $file: $!";
while (<$fh>) {
    next if /^\s*$/ || /^\s*#/;
    chomp;
    # control-flow and block-starting keywords signal a full script
    if (/^\s*(?:BEGIN|END|sub|use|require|package|for(?:each)?|while|if|unless|my|our|local)\b/) {
        exit 1;
    }
    last;
}
exit 0;
EOPL
} # _perlrepl_needs_n

# divide input file $1 into source ($2), data ($3), and args ($4) files
_perlrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa]'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\(ument\)*[Ss]*:*[[:space:]]*'

    # extract arguments
    sed -n \
      -e "s/$argshdr//w $args" \
      "$in"

    # split the input file at the '#DATA' header and write into two files
    sed -n \
      -e "1,/$datahdr/w $src" \
      -e "/$datahdr/,\$w $data" \
      "$in"

    # remove '#DATA' header from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
} # _perlrepl_divide

# _repl_parse_args FILE — print the #ARGS tokens NUL-separated, honoring shell
# quotes (so a value may contain spaces) but WITHOUT globbing or any variable/
# command expansion. xargs only splits and unquotes; it never expands, so a
# literal '*' stays '*'.
_repl_parse_args() {
    local f=${1:?missing args file}
    grep -q '[^[:space:]]' "$f" 2>/dev/null || return 0
    xargs printf '%s\0' < "$f" 2>/dev/null
}

# the tmux subshells need these
export -f _repl_parse_args
export -f _sed_in_place
export -f _perlrepl_divide
export -f _perlrepl_pretty_print
export -f _perlrepl_needs_n

_perlrepl_setup() {
    local replfile=${1:?missing replfile argument}
    local src data args runner formatter cleanup
    src=$(mktemp "${TMPDIR:-/tmp}/perlrepl-src-XXXXXX")         || { echo "perlrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp "${TMPDIR:-/tmp}/perlrepl-data-XXXXXX")        || { echo "perlrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp "${TMPDIR:-/tmp}/perlrepl-args-XXXXXX")        || { echo "perlrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp "${TMPDIR:-/tmp}/perlrepl-run-XXXXXX")       || { echo "perlrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp "${TMPDIR:-/tmp}/perlrepl-fmt-XXXXXX")    || { echo "perlrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp "${TMPDIR:-/tmp}/perlrepl-cleanup-XXXXXX")  || { echo "perlrepl: mktemp failed" >&2; return 1; }

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    local q_replfile q_src q_data q_args q_runner q_formatter q_cleanup
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    # _perlrepl_needs_n detects bare per-line expressions and adds -n
    # (like awk's default record loop) when data is present.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _perlrepl_divide _perlrepl_needs_n _repl_parse_args)
_perlrepl_divide $q_replfile $q_src $q_data $q_args
if [[ -s $q_src ]]; then
    _perl_args=()
    if [[ -s $q_data ]] && _perlrepl_needs_n $q_src; then
        _perl_args+=( -n )
    fi
    while IFS= read -r -d '' _a; do _perl_args+=( "\$_a" ); done < <(_repl_parse_args $q_args)
    _perl_args+=( $q_src )
    [[ -s $q_data ]] && _perl_args+=( $q_data )
    echo "$(tput setaf 0)# work dir: \$PWD$(tput sgr0)"
    echo "$(tput setaf 0)# command:  perl \${_perl_args[*]}$(tput sgr0)"
    echo
    _bat=\$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    if [[ -n "\$_bat" ]]; then
        "\$_bat" -l perl -p --tabs=4 $q_src 2>/dev/null
    else
        cat $q_src
    fi
    echo
    perl "\${_perl_args[@]}"
fi
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _perlrepl_pretty_print)
sleep 1
_perlrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_cleanup
CLEANUP

    chmod a+x "$runner" "$formatter" "$cleanup"

    # These globals are read by the caller after _perlrepl_setup returns.
    # shellcheck disable=SC2034
    REPL_REPLFILE="$replfile"   REPL_SRC="$src"         REPL_DATA="$data"
    # shellcheck disable=SC2034
    REPL_ARGS="$args"           REPL_RUNNER="$runner"   REPL_FORMATTER="$formatter"
    # shellcheck disable=SC2034
    REPL_CLEANUP="$cleanup"
    # shellcheck disable=SC2034
    REPL_Q_REPLFILE="$q_replfile" REPL_Q_SRC="$q_src"   REPL_Q_RUNNER="$q_runner"
    # shellcheck disable=SC2034
    REPL_Q_FORMATTER="$q_formatter" REPL_Q_CLEANUP="$q_cleanup"
} # _perlrepl_setup

perlrepl() {
    local replfile="$HOME/.repl.pl"
    test -f "$replfile" || touch "$replfile"
    (( ${TRACE:-} )) && set -x
    _perlrepl_setup "$replfile" || return 1
    tmux new${TMUX:+w} -n 'perlrepl'                              \
      "${EDITOR:-nano}" "$replfile" \;                              \
      split-window    -c "$PWD"                                     \
        "echo $REPL_Q_REPLFILE | entr -c $REPL_Q_RUNNER" \;       \
      split-window -h -c "$PWD"                                     \
        "echo $REPL_Q_SRC | entr -c $REPL_Q_FORMATTER" \;         \
      select-pane -t 1 \;                                           \
      select-pane -t 2 \;                                           \
      select-pane -t 0 \;                                           \
      set-hook 'pane-exited[0]' "run-shell $REPL_Q_CLEANUP" \;    \
      set-hook 'pane-exited[1]' kill-window

    # Backstop cleanup: the 'pane-exited' hooks above are unreliable on some
    # tmux builds, leaking temp files. When we launched a NEW session (not
    # nested — $TMUX was unset), 'tmux new' blocks until it exits, so by here
    # the panes are gone and it is safe to remove the temp files ourselves.
    if [[ -z "${TMUX:-}" ]]; then
        rm -f "$REPL_SRC" "$REPL_DATA" "$REPL_ARGS" "$REPL_RUNNER" \
              "$REPL_FORMATTER" "$REPL_CLEANUP"
    fi
}

# allow sourcing for tests without launching the REPL
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && perlrepl "$@"
