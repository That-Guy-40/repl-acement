#!/usr/bin/env bash
##
##  mlrrepl - a REPL for Miller (mlr)
##
##  Based on awkrepl by Kevin Ernst <ernstki -at- mail.uc.edu>
##  License:  MIT
##
##  Requirements:
##    - miller (mlr) ≥ 5 - https://miller.readthedocs.io/
##    - tmux ≥ 2
##    - entr - http://eradman.com/entrproject/
##    - bat (optional) - https://github.com/sharkdp/bat
##
##  Miller DSL expressions are read from a file with 'mlr put -f', which
##  completely sidesteps shell quoting of $-fields and string literals.
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "mlrrepl: error at line $LINENO" >&2; exit 1' ERR

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_mlrrepl_pretty_print() {
    local src=${1:?missing mlr source file argument}
    local cat='cat'

    if [[ $(type -t bat) == file ]]; then
        cat='bat -l ruby -p --tabs=4'   # Ruby is close enough for mlr DSL highlighting
    fi

    [[ -s "$src" ]] && $cat "$src"
} # _mlrrepl_pretty_print

# divide input file $1 into source ($2), data ($3), and args ($4) files
_mlrrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa]'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\(ument\)*[Ss]*:*[[:space:]]*'

    # extract arguments
    sed -n \
      -e "s/$argshdr//w $args" \
      "$in"

    # split the input file at the '#DATA' header and write into two files
    sed -n \
      -e "1,/$datahdr/w $src" \
      -e "/$datahdr/,\$w $data" \
      "$in"

    # remove '#DATA' header from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
} # _mlrrepl_divide

# sniff the first line of a data file; return '--csv' if it contains a comma,
# '--jsonl' if it looks like a JSON object, '--nidx' otherwise
_mlrrepl_detect_format() {
    local data=${1:?missing data file argument}
    local first
    first=$(head -1 "$data")
    case "$first" in
        '{'*)  echo '--jsonl' ;;   # JSON object before comma check (JSONL contains commas)
        *,*)   echo '--csv'   ;;
        *)     echo '--nidx'  ;;
    esac
} # _mlrrepl_detect_format

# the tmux subshells need these
export -f _sed_in_place
export -f _mlrrepl_divide
export -f _mlrrepl_pretty_print
export -f _mlrrepl_detect_format

mlrrepl() {
    local replfile="$HOME/.repl.mlr"
    local src data args runner formatter cleanup
    src=$(mktemp /tmp/mlrrepl-src-XXXXXX)         || { echo "mlrrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp /tmp/mlrrepl-data-XXXXXX)        || { echo "mlrrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp /tmp/mlrrepl-args-XXXXXX)        || { echo "mlrrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp /tmp/mlrrepl-run-XXXXXX)       || { echo "mlrrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp /tmp/mlrrepl-fmt-XXXXXX)    || { echo "mlrrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp /tmp/mlrrepl-cleanup-XXXXXX)  || { echo "mlrrepl: mktemp failed" >&2; return 1; }

    # make sure the file exists, since 'entr' needs it to exist
    test -f "$replfile" || touch "$replfile"

    (( ${TRACE:-} )) && set -x

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    local q_replfile q_src q_data q_args q_runner q_formatter q_cleanup
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    # 'mlr put -f $src' reads the DSL from a file, sidestepping all quoting
    # issues with $field references and string literals.
    # #ARGS content goes into _mlr_args array; avoids the _user_args/$cmd chain
    # that allowed word-split #ARGS content to reach an unquoted $cmd execution.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _mlrrepl_divide _mlrrepl_detect_format)
_mlrrepl_divide $q_replfile $q_src $q_data $q_args
if [[ -s $q_src ]]; then
    if [[ -s $q_data ]]; then
        # shellcheck disable=SC2046
        _mlr_args=( \$(cat $q_args) )
        [[ \${#_mlr_args[@]} -eq 0 ]] && _mlr_args=( \$(_mlrrepl_detect_format $q_data) )
        echo "$(tput setaf 0)# work dir: \$PWD$(tput sgr0)"
        echo "$(tput setaf 0)# command:  mlr \${_mlr_args[*]} put -f $q_src $q_data$(tput sgr0)"
        echo
        if [[ \$(type -t bat) == file ]]; then
            bat -l ruby -p --tabs=4 $q_src
        else
            cat $q_src
        fi
        echo
        mlr "\${_mlr_args[@]}" put -f $q_src $q_data
    else
        echo 'mlrrepl: no #DATA section — add data below a #DATA marker'
    fi
fi
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _mlrrepl_pretty_print)
sleep 1
_mlrrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_cleanup
CLEANUP

    chmod a+x "$runner" "$formatter" "$cleanup"

    # start a new session, or a new window if we're already in tmux
    # q_* paths are already shell-quoted by printf '%q', so no surrounding
    # single quotes are needed — this also prevents single-quote injection.
    tmux new${TMUX:+w} -n 'mlrrepl'                              \
      "${EDITOR:-nano}" "$replfile" \;                             \
      split-window    -c "$PWD"                                    \
        "echo $q_replfile | entr -c $q_runner" \;                 \
      split-window -h -c "$PWD"                                    \
        "echo $q_src | entr -c $q_formatter" \;                   \
      select-pane -t 1 \;                                          \
      select-pane -t 2 \;                                          \
      select-pane -t 0 \;                                          \
      set-hook 'pane-exited[0]' "run-shell $q_cleanup" \;         \
      set-hook 'pane-exited[1]' kill-window
}

# allow sourcing for tests without launching the REPL
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && mlrrepl "$@"
