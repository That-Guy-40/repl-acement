#> tool: mlrrepl
#> wait: 2998.00 CRYPTOMART
#> pause: 45
#> must: 5105105105105100 2999.00 CRYPTOMART
#> must: 5105105105105100 2995.00 CRYPTOMART
#> must: # command:  mlr --icsv --opprint put
#> not: T1033
#> not: 1500.00
#> not: mismatch
#> source: filter $amount
# 8. Miller: fields by name, output as a table. Three buys at a crypto exchange, each a few
# dollars under the $3,000 review threshold. Nobody spends $2,995 by accident.
#ARGS --icsv --opprint
filter $amount > 2900 && $amount < 3000;

#DATA
@CSV@
