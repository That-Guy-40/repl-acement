# 6. Impossible travel needs memory across lines. perlrepl sees a bare per-line script
# and adds -n for you: check the command line below. New York to Lagos in 36 minutes.
chomp; my ($id, $ts, $card, $amt, $m, $mcc, $cc, $ch, $dev) = split /,/;
next if $id eq 'id';
my ($h, $mi) = $ts =~ /T(\d\d):(\d\d)/;  my $min = $h * 60 + $mi;
if ($seen{$card} && $cc ne $seen{$card}[0] && $min - $seen{$card}[1] < 120) {
    printf "%s: %s -> %s in %d min (%s %.2f)\n",
        $card, $seen{$card}[0], $cc, $min - $seen{$card}[1], $m, $amt;
}
$seen{$card} = [$cc, $min];

