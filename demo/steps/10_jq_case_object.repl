#> tool: jqrepl
#> wait: "txns": 7
#> pause: 50
#> must: "device": "dev-c0ffee"
#> must: "total": 12422
#> must: "5105105105105100"
#> must: # command:  jq -R -s
#> not: dev-fam01
#> source: group_by
# 10. jq straight off the CSV (-R raw lines, -s slurp): the ring's case object.
#ARGS -R -s
split("\n")[1:] | map(select(length > 0) | split(",")
  | {card: .[2], amt: (.[3] | tonumber), dev: .[8]})
| group_by(.dev) | map(select((map(.card) | unique | length) >= 3))
| .[] | {device: .[0].dev, cards: (map(.card) | unique),
         total: (map(.amt) | add), txns: length}

#DATA
@CSV@
