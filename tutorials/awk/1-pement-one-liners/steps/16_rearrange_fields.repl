#> tool: awkrepl
#> wait: swapped: 4.00 Beth 0
#> pause: 45
#> must: swapped: 4.00 Beth 0
#> must: reversed: 0 4.00 Beth
#> not: swapped: Beth 4.00 0
#> source: "reversed: "
# 16. Rearrange fields. Pement: awk '{print $2, $1}' and the field-reversal loop
#   awk '{for (i=NF; i>0; i--) printf("%s ",i);printf ("\n")}'
# Careful: the sheet's version prints i, the field NUMBER. You want $i.
# The comma in print inserts OFS; the "%s " in printf adds a trailing space.
# Try: delete field 2 with  $2 = ""; print  and notice the double space it leaves.
NF { printf "swapped: %s %s %s\n", $2, $1, $3
     printf "reversed: "; for (i = NF; i > 0; i--) printf "%s ", $i; printf "\n" }

#DATA
Beth    4.00  0
Dan     3.75  0
