# 10. Print lines whose last field is over 15. Pement: awk '$NF > 4'
# A comparison is a pattern; no action means print. Blank lines have $NF = ""
# which is not a number, so they compare as strings and don't pass.
# Try: NF > 2 prints every non-blank line (they all have 3 fields).
$NF > 15

