# 6. Replace every field with its absolute value. Pement:
#   awk '{for (i=1; i<=NF; i++) if ($i < 0) $i = -$i; print }'
# Assigning to a field ($i = ...) rebuilds $0 with the output separator.
# Try: the ternary form, $i = ($i < 0) ? -$i : $i
{ for (i = 1; i <= NF; i++) if ($i < 0) $i = -$i; print }

