# 2. Number every line, right-aligned. Pement: awk '{printf("%5d : %s\n", NR,$0)}'
# NR is the record (line) number. printf with %5d pads the number to five columns.
# awkrepl wraps this bare statement in { } for you: look at the source pane.
# Try: use FNR instead of NR (same here: one file), or "%-5d" to left-align.
printf("%5d : %s\n", NR, $0)

