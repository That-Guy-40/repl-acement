#> not: 10 lines
#> source: " lines"
# 4. Count lines, like wc -l. Pement: awk 'END{print NR}'
# END runs once after the last line; by then NR holds the total.
# (Blank lines count: wc -l counts newlines, and so does NR.)
# Try: print NR without END and watch it count up instead.
END { print NR " lines" }

