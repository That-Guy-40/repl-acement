#> tool: awkrepl
#> wait: 280154 bytes in 8 files
#> pause: 30
#> must: average 35019
#> must: largest 204800
#> not: 35019.2
#> source: "average"
# 5. Arithmetic: + - * / % ^, and the += and ++ shorthands
# Variables start out as 0 (or ""), so you can add to them without declaring them.
# total += $5 adds the size; n++ counts; int() drops the fraction.
# Try: print total / n without int() and compare.
NF == 9 { total += $5; n++; if ($5 > max) max = $5 }
END {
    print total, "bytes in", n, "files"
    print "average", int(total / n)
    print "largest", max
}

