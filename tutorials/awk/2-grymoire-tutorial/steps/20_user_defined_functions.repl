#> must: photo.jpg 200.0K
#> not: secrets.env 0.5K
#> source: human
# 20. Your own functions
# function name(params) { ... return value } can go anywhere outside a rule.
# Parameters are local; anything else is global, so extra "parameters" are the
# usual trick for local variables (that is what the gap before kb is for).
# Try: add a branch for >= 1048576 that returns megabytes.
function human(bytes,    kb) {
    kb = bytes / 1024
    return bytes >= 1024 ? sprintf("%.1fK", kb) : bytes "B"
}
NF == 9 { print $9, human($5) }

