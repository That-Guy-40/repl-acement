#> tool: awkrepl
#> wait: 2: 280
#> pause: 30
#> must: 9: notes.txt
#> must: 9: photo.jpg
#> not: 9: 280
#> source: NF ": "
# 9. NF: how many fields this line has, and $NF the last one
# NF changes line by line. The "total 280" line that ls prints has 2 fields, every
# real entry 9. $NF is "the field whose number is NF": the last one, whatever NF is.
# Try: print $(NF-1) to get the time column.
{ print NF ": " $NF }

