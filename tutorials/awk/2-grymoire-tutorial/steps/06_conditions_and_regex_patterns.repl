#> tool: awkrepl
#> wait: script: deploy.sh
#> pause: 30
#> must: big: photo.jpg
#> must: alice's: notes.txt
#> not: big: report.pdf
#> source: "script:"
# 6. Patterns: comparisons, regular expressions, && and ||
# /regex/ matches the whole line; $3 == "alice" compares a field; && and || combine.
# A line can match several rules; each one that matches runs its action.
# Try: change the size test to > 10000 and watch report.pdf join the big list.
/\.sh$/            { print "script:", $9 }
$5 > 100000        { print "big:", $9 }
$3 == "alice" && NF == 9 { print "alice's:", $9 }

#DATA
