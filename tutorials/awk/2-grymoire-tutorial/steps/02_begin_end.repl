#> tool: awkrepl
#> wait: 9 lines, 8 of them files
#> pause: 30
#> must: == listing ==
#> not: notes.txt
#> source: entries done
# 2. BEGIN and END run once, before and after the data
# BEGIN runs before the first line is read, END after the last. Neither sees a line,
# so they are the place for headings, totals and summaries. The middle rule counts.
# Try: print NR in the END block as well; it holds the number of lines read.
BEGIN { print "== listing ==" }
NF == 9 { files++ }
END   { print NR " lines, " files " of them files"; print "entries done" }

