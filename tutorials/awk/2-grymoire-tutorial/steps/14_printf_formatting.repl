#> tool: awkrepl
#> wait: 0.3 MiB total
#> pause: 30
#> must: notes.txt        1204 alice
#> must: secrets.env       512 bob
#> not: 0.267
#> source: %-12s
# 14. printf: columns that line up
# %s a string, %d an integer, %f a float. A number before the letter is the minimum
# width; a minus sign left-justifies; .1 is the precision. printf adds no newline.
# Try: change %-12s to %12s and see the names move to the right.
NF == 9 { printf "%-12s %8d %s\n", $9, $5, $3; total += $5 }
END     { printf "%5.1f MiB total\n", total / 1048576 }

