#> source: SUBSEP
# 13. Two-dimensional keys: count[$3, $4]
# awk fakes multi-dimensional arrays by joining the subscripts with SUBSEP, an
# unprintable character. split() on SUBSEP gets the parts back out.
# Try: use (owner, group) in count to test for one combination in END.
BEGIN { PROCINFO["sorted_in"] = "@ind_str_asc" }
NF == 9 { count[$3, $4]++ }
END {
    for (key in count) {
        split(key, part, SUBSEP)
        print part[1], part[2], count[key]
    }
}

