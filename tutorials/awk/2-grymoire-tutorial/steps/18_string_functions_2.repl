#> tool: awkrepl
#> wait: n*t*s.txt
#> pause: 30
#> must: notes.txt -> txt 2 n*t*s.txt
#> must: src -> (none) 1 src
#> not: src -> src
#> source: RSTART
# 18. More string functions: split, sub, gsub, match
# split(s, arr, sep) breaks s into arr[1..n] and returns n. sub replaces the first
# match, gsub all of them, both in place. match(s, /re/) returns the position and sets
# RSTART and RLENGTH so you can cut the match out with substr.
# Try: use sub(/\.[a-z]+$/, "", name) to strip the extension.
NF == 9 {
    n = split($9, part, ".")
    if (match($9, /\.[a-z]+$/)) ext = substr($9, RSTART + 1, RLENGTH - 1)
    else ext = "(none)"
    name = $9; gsub(/[aeiou]/, "*", name)
    print $9, "->", ext, n, name
}

