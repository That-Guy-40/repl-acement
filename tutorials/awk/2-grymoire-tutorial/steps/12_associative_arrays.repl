#> source: bytes
# 12. Associative arrays: totals by name
# bytes[$3] += $5 keeps one running total per owner, keyed by the owner's name.
# No declaration, no sizing: a new key appears the first time you use it.
# The END loop walks every key. The order is up to awk, which is why reports sort
# or, as here, ask gawk for alphabetical order with PROCINFO["sorted_in"].
# Try: key on $4 (the group) instead.
BEGIN { PROCINFO["sorted_in"] = "@ind_str_asc" }
NF == 9 { bytes[$3] += $5 }
END { for (owner in bytes) print owner, bytes[owner] }

