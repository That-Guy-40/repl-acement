#> tool: awkrepl
#> wait: found dave: backup.sh
#> pause: 30
#> must: checking notes.txt
#> must: done, stopped at line 8
#> not: checking todo.md
#> source: "checking"
# 15. next and exit: controlling the flow between lines
# next skips the remaining rules for this line and reads the next one.
# exit stops reading altogether, then still runs END. todo.md is never checked.
# Try: remove the exit and see every file get checked.
/^total/ { next }
$3 == "dave" { print "found dave:", $9; exit }
{ print "checking", $9 }
END { print "done, stopped at line", NR }

