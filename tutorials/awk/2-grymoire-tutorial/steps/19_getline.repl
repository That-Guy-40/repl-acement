#> tool: awkrepl
#> wait: hello from a pipe
#> pause: 30
#> must: first entry after total: notes.txt
#> must: last line: todo.md
#> not: first entry after total: total
#> source: getline
# 19. getline: reading the next line yourself
# Plain getline replaces $0 (and NF, NR) with the next line, inside a rule.
# "command" | getline var runs a shell command and reads its output into var.
# getline < "file" reads from another file the same way.
# Try: replace the echo command with "date" (the output will change every save).
BEGIN { "echo hello from a pipe" | getline greeting; print greeting }
/^total/ { getline; print "first entry after total:", $9 }
END { print "last line:", $9 }

#DATA
