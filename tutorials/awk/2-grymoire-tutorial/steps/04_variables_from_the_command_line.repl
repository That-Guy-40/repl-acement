#> source: limit
# 4. Variables from the command line: -v name=value
# awk -v limit=5000 sets a variable before the program starts, so one script can be
# reused with different settings. In awkrepl the #ARGS line is the command line.
# A pattern that is a comparison prints the matching lines.
# Try: change 5000 to 50000 in the #ARGS line.
#ARGS -v limit=5000
$5 > limit { print $9, $5 }

