#> tool: awkrepl
#> wait: Notes.txt 9 6
#> pause: 30
#> must: Photo.jpg 9 6
#> must: Src 3 0
#> not: notes.txt 9 6
#> source: toupper
# 17. String functions: length, index, substr, toupper
# length(s) counts characters; index(s, t) finds t in s (0 if absent);
# substr(s, start, len) cuts a piece (positions start at 1); toupper/tolower change case.
# Capitalising a word is substr + toupper + the rest.
# Try: print substr($9, index($9, ".") + 1) to get just the extension.
NF == 9 { print toupper(substr($9, 1, 1)) substr($9, 2), length($9), index($9, ".") }

