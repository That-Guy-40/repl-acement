#!/usr/bin/env bash
##
##  awkrepl - a REPL for AWK
##
##  Author:    Kevin Ernst <ernstki -at- mail.uc.edu>
##  Homepage:  https://github.com/ernstki/awkrepl
##  License:   MIT
##
##  Requirements:
##    - GNU awk, as 'gawk'
##    - tmux ≥ 2 (I think)
##    - entr - http://eradman.com/entrproject/
##    - xargs (used to parse '#ARGS' lines)
##    - bat (optional; also found as 'batcat') - https://github.com/sharkdp/bat
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "awkrepl: error at line $LINENO" >&2; exit 1' ERR

# AWK helper functions for associative arrays
# h/t: https://unix.stackexchange.com/a/522898/278323
# shellcheck disable=SC2016
AWKHELPERS='# vim: ft=awk
    function printerr(msg) {
        printf "ERROR: %s\n", msg > "/dev/stderr"
    }

    function printa(a,  name,fs,l,i) {
        name = name ? name : "noname"
        fs = fs ? fs : "; "
        l = length(a)

        printf "length(%s)==%i\n", name, l

        for (i=1; i<=l; i++) {
            if (!(i in a)) {
                print ""
                printerr(sprintf("Array%s is not 1-based or is non-contiguous. "\
                    "Use `printaa` instead.",
                    name == "noname" ? "" : sprintf(" `%s`", name)))
                return
            }
            printf "%s[%s]=%s", name, i, (i<l-1) ? a[i] fs : a[i] "\n"
        }
    } # printa - print a numerically-indexed array

    function printaa(a,  name,fs,l,n,i) {
        name = name ? name : "noname"
        fs = fs ? fs : "; "
        l = length(a)
        n = 1  # keep track of which element we are on

        printf "length(%s)==%i\n", name, l

        for (i in a) {
            printf "%s[%s]=%s", name, i, (n<l) ? a[i] fs : a[i] "\n"
            n++
        }
    } # printaa - the associative array version
'

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_trim_blanks() {
    local in=${1:?missing input file argument}
    # macOS doesn't have 'tac'
    local tac='tac'; [[ $(uname -s) == Darwin ]] && tac='tail -r'
    local tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/awkrepl-XXXXXX") || { echo "awkrepl: mktemp failed" >&2; return 1; }
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" RETURN

    # trim spaces from the front; reverse; trim spaces from the front; reverse
    sed -e '1,/^[^[:space:]]/ { /^[[:space:]]*$/d; }' "$in" \
      | $tac \
      | sed -e '1,/^[^[:space:]]/ { /^[[:space:]]*$/d; }' \
      | $tac \
      > "$tmp"

    mv -f "$tmp" "$1"
}

_awkrepl_pretty_print() {
    local src=${1:?missing AWK source file argument}
    local cat='cat'

    local _bat
    _bat=$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    [[ -n "$_bat" ]] && cat="$_bat -l awk -p --tabs=4"

    if ! gawk --pretty-print=- -f "$src" | $cat 2>/dev/null; then
        echo -e "\nERROR parsing AWK source; input was:"
        $cat "$src" 2>/dev/null
    fi
} # _awkrepl_pretty_print

# _awkrepl_parses GAWK-PROGRAM-ARGS... — true if gawk can parse the program
# (e.g. `-f file` or `-e text`). --pretty-print parses without running it, so
# BEGIN blocks and getline never execute here.
_awkrepl_parses() {
    gawk --pretty-print=/dev/null "$@" >/dev/null 2>&1
}

# _awkrepl_looks_like_statement FILE — for source that parses both as written
# and wrapped (a bare expression is valid both as a pattern and as a
# statement), guess which was meant from how it starts. A pattern-like start
# ('{', '!', '/', '(', '$', a literal, NR/NF/FNR/FILENAME) means a pattern; so
# does any comparison or match operator. Anything else that starts with a
# name (an assignment, a function call such as printa(arr), i++) is taken as
# a statement.
_awkrepl_looks_like_statement() {
    local first pat='^[{!/($0-9"-]'
    first=$(sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}' "$1")
    [[ $first =~ $pat ]] && return 1
    [[ $first =~ ^(NR|NF|FNR|FILENAME)([^A-Za-z0-9_]|$) ]] && return 1
    # look for operators outside string literals (so s = "<td>" $1 is a statement)
    ! sed -E 's/"([^"\\]|\\.)*"//g' "$1" | grep -qE '==|!=|<|>|~'
}

# divide input file $1 into source ($2), data ($3), and args ($4) files
_awkrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    # Headers (case-insensitive): '#DATA' must be alone on its line, and
    # '#ARGS' (or #ARG / #ARGUMENT(S)) must be followed by nothing or by options
    # starting with '-'. So comments like '# Database…', '# data comes from…'
    # or '# Args are cool' stay comments. In argshdr, \3 is the options part.
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa][:[:space:]]*$'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\([Uu][Mm][Ee][Nn][Tt]\)\{0,1\}[Ss]\{0,1\}\([:[:space:]]\{1,\}\(-.*\)\)\{0,1\}[:[:space:]]*$'

    # extract arguments
    sed -n \
      -e "s/$argshdr/\3/w $args" \
      "$in"

    # split the input file at the '#DATA' header and write into two files
    sed -n \
      -e "1,/$datahdr/w $src" \
      -e "/$datahdr/,\$w $data" \
      "$in"

    # remove '#DATA' header from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code; trim blanks
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
    _trim_blanks "$src"

    # remove comments and blank lines from source (see #6)
    _sed_in_place -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$src"

    # Auto-wrap a bare program such as 'print $1' or 'printa(arr)' in
    # '{ … }' when there's #DATA, or in 'END { … }' when there isn't. gawk
    # checks the whole program both ways (it only parses, never runs it):
    #   - parses only as written (rules with actions, function definitions,
    #     BEGIN/END, …): leave it alone
    #   - parses only wrapped (statements such as 'print $1'): wrap it
    #   - parses neither way: leave it, so the error is about the user's code
    #   - parses both ways (a bare expression): wrap it if it looks like a
    #     statement rather than a pattern such as '!/re/' or '$NF > 3'
    local opener='{' wrapped as_written=0 as_wrapped=0
    [[ -s "$data" ]] || opener='END {'
    wrapped=$(printf '%s\n' "$opener"; cat "$src"; printf '}\n')
    _awkrepl_parses -f "$src"     && as_written=1
    _awkrepl_parses -e "$wrapped" && as_wrapped=1
    if (( as_wrapped )) && { (( ! as_written )) || _awkrepl_looks_like_statement "$src"; }; then
        printf '%s\n' "$wrapped" > "$src"
    fi
    return 0
} # _awkrepl_divide

# _repl_parse_args FILE — print the #ARGS tokens NUL-separated, honoring shell
# quotes (so a value may contain spaces) but WITHOUT globbing or any variable/
# command expansion. xargs only splits and unquotes; it never expands, so a
# literal '*' stays '*'. Read the result with:
#   args=(); while IFS= read -r -d '' a; do args+=("$a"); done < <(_repl_parse_args "$f")
_repl_parse_args() {
    local f=${1:?missing args file}
    local -a w
    grep -q '[^[:space:]]' "$f" 2>/dev/null || return 0   # nothing but whitespace
    if xargs true < "$f" >/dev/null 2>&1; then
        xargs printf '%s\0' < "$f"
    else
        # xargs rejects an unmatched quote (e.g. "it's") and would drop every
        # argument. Say so, and fall back to splitting on whitespace with the
        # quote characters kept as typed (still no globbing: read never globs).
        echo "warning: #ARGS has an unmatched quote; splitting it on whitespace instead" >&2
        while read -r -a w || (( ${#w[@]} )); do
            (( ${#w[@]} )) && printf '%s\0' "${w[@]}"
        done < "$f"
    fi
}

# the tmux subshells need these
export -f _sed_in_place
export -f _awkrepl_divide
export -f _awkrepl_pretty_print
export -f _awkrepl_parses
export -f _awkrepl_looks_like_statement
export -f _repl_parse_args

_awkrepl_setup() {
    local replfile=${1:?missing replfile argument}
    local src data args runner formatter helpers cleanup editpane
    src=$(mktemp "${TMPDIR:-/tmp}/awkrepl-src-XXXXXX")         || { echo "awkrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp "${TMPDIR:-/tmp}/awkrepl-data-XXXXXX")        || { echo "awkrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp "${TMPDIR:-/tmp}/awkrepl-args-XXXXXX")        || { echo "awkrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp "${TMPDIR:-/tmp}/awkrepl-run-XXXXXX")       || { echo "awkrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp "${TMPDIR:-/tmp}/awkrepl-fmt-XXXXXX")    || { echo "awkrepl: mktemp failed" >&2; return 1; }
    helpers=$(mktemp "${TMPDIR:-/tmp}/awkrepl-helpers-XXXXXX")  || { echo "awkrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp "${TMPDIR:-/tmp}/awkrepl-cleanup-XXXXXX")  || { echo "awkrepl: mktemp failed" >&2; return 1; }
    editpane=$(mktemp "${TMPDIR:-/tmp}/awkrepl-edit-XXXXXX")     || { echo "awkrepl: mktemp failed" >&2; return 1; }

    # AWK array helper functions like printa and printaa
    echo "$AWKHELPERS" > "$helpers"

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    # Note: _awkrepl_divide passes the raw paths to sed's 'w filename', which
    # (in GNU sed) takes the rest of the expression, spaces included.
    local q_replfile q_src q_data q_args q_helpers q_runner q_formatter q_cleanup q_editpane
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_helpers=$(printf '%q' "$helpers")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")
    q_editpane=$(printf '%q' "$editpane")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _trim_blanks _awkrepl_parses _awkrepl_looks_like_statement _awkrepl_divide _repl_parse_args)
_awkrepl_divide $q_replfile $q_src $q_data $q_args
_gawk_args=()
while IFS= read -r -d '' _a; do _gawk_args+=( "\$_a" ); done < <(_repl_parse_args $q_args)
echo "$(tput setaf 0)# work dir: \$PWD$(tput sgr0)"
echo "$(tput setaf 0)# command:  gawk \${_gawk_args[*]} -f $q_helpers -f $q_src $q_data$(tput sgr0)"
gawk "\${_gawk_args[@]}" -f $q_helpers -f $q_src $q_data
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _awkrepl_pretty_print)
sleep 1
_awkrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_helpers $q_editpane $q_cleanup
CLEANUP

    # Pane 0 runs this wrapper rather than the editor itself. When the editor
    # exits, or the window is killed (SIGHUP), it removes the temp files and
    # closes this REPL's window, found from its own pane ($TMUX_PANE), so it
    # never touches other windows when the REPL runs inside an existing tmux
    # session. (tmux 'pane-exited' hooks can't be scoped like that: tmux
    # resolves them against the session's current window, whichever pane
    # exited.) $EDITOR is run by the shell, as git does, so it may carry
    # flags (e.g. 'code -w' or 'emacsclient -t'). The editor runs as a child
    # the wrapper waits on, so a hangup (the window killed) is handled at
    # once: bash defers a trap until a foreground child exits, and the
    # killed window's editor might never exit. '<&0' keeps the pane's
    # terminal as its input (a background command would get /dev/null).
    cat > "$editpane" <<EDITPANE
#!/usr/bin/env bash
_editor=
_done() {
    trap - HUP TERM
    [[ -n "\$_editor" ]] && kill "\$_editor" 2>/dev/null
    $q_cleanup
    [[ -n "\${TMUX_PANE:-}" ]] && tmux kill-window -t "\$TMUX_PANE" 2>/dev/null
    exit 0
}
trap _done HUP TERM
trap '' INT QUIT
${EDITOR:-nano} $q_replfile <&0 &
_editor=\$!
wait "\$_editor"
_editor=
_done
EDITPANE

    chmod a+x "$runner" "$formatter" "$cleanup" "$editpane"

    # These globals are read by the caller after _awkrepl_setup returns.
    # shellcheck disable=SC2034
    REPL_REPLFILE="$replfile"   REPL_SRC="$src"         REPL_DATA="$data"
    # shellcheck disable=SC2034
    REPL_ARGS="$args"           REPL_HELPERS="$helpers"  REPL_RUNNER="$runner"
    # shellcheck disable=SC2034
    REPL_FORMATTER="$formatter" REPL_CLEANUP="$cleanup" REPL_EDITPANE="$editpane"
    # shellcheck disable=SC2034
    REPL_Q_REPLFILE="$q_replfile" REPL_Q_SRC="$q_src"   REPL_Q_HELPERS="$q_helpers"
    # shellcheck disable=SC2034
    REPL_Q_RUNNER="$q_runner"  REPL_Q_FORMATTER="$q_formatter" REPL_Q_CLEANUP="$q_cleanup" REPL_Q_EDITPANE="$q_editpane"
} # _awkrepl_setup

awkrepl() {
    local replfile="$HOME/.repl.awk"
    test -f "$replfile" || touch "$replfile"
    (( ${TRACE:-} )) && set -x
    _awkrepl_setup "$replfile" || return 1
    # if a runner/formatter pane's entr exits, close this REPL's window too
    # (the editor pane's wrapper then removes the temp files)
    # shellcheck disable=SC2016  # $TMUX_PANE is expanded later, by the pane's shell
    local close='; tmux kill-window -t "$TMUX_PANE"'
    # A new session (not nested in tmux) gets a known name, so the cleanup
    # below can tell "the session ended" from "the client only detached".
    local session="awkrepl-$$"
    local -a launch=(new-session -s "$session")
    if [[ -n "${TMUX:-}" ]]; then launch=(new-window); fi
    tmux "${launch[@]}" -n 'awkrepl'                               \
      "$REPL_Q_EDITPANE" \;                                        \
      split-window    -c "$PWD"                                    \
        "echo $REPL_Q_REPLFILE | entr -c $REPL_Q_RUNNER$close" \;  \
      split-window -h -c "$PWD"                                    \
        "echo $REPL_Q_SRC | entr -c $REPL_Q_FORMATTER$close" \;    \
      select-pane -t 1 \;                                          \
      select-pane -t 2 \;                                          \
      select-pane -t 0

    # Backstop cleanup. The editor pane's wrapper removes the temp files when
    # the editor exits or the window is killed; this covers the rare case it
    # can't (e.g. its process was SIGKILLed). A new session's 'tmux
    # new-session' returns both when the session ends and when the client
    # merely detaches, so only clean up once our named session is really
    # gone: a detached session still needs these files. In the nested case
    # ('new-window' returns at once) the window is still live, so cleanup is
    # left to the wrapper.
    if [[ -z "${TMUX:-}" ]] && ! tmux has-session -t "=$session" 2>/dev/null; then
        rm -f "$REPL_SRC" "$REPL_DATA" "$REPL_ARGS" "$REPL_RUNNER" \
              "$REPL_FORMATTER" "$REPL_CLEANUP" "$REPL_EDITPANE" "${REPL_HELPERS:-}"
    fi
}

# allow sourcing for tests without launching the REPL
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && awkrepl "$@"
