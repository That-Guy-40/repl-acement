#!/usr/bin/env bash
##
##  awkrepl - a REPL for AWK
##
##  Author:    Kevin Ernst <ernstki -at- mail.uc.edu>
##  Homepage:  https://github.com/ernstki/awkrepl
##  License:   MIT
##
##  Requirements:
##    - GNU awk, as 'gawk'
##    - Perl
##    - tmux ≥ 2 (I think)
##    - entr - http://eradman.com/entrproject/
##    - bat (optional) - https://github.com/sharkdp/bat
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "awkrepl: error at line $LINENO" >&2; exit 1' ERR

# AWK helper functions for associative arrays
# h/t: https://unix.stackexchange.com/a/522898/278323
# shellcheck disable=SC2016
AWKHELPERS='# vim: ft=awk
    function printerr(msg) {
        printf "ERROR: %s\n", msg > "/dev/stderr"
    }

    function printa(a,  name,fs,l,i) {
        name = name ? name : "noname"
        fs = fs ? fs : "; "
        l = length(a)

        printf "length(%s)==%i\n", name, l

        for (i=1; i<=l; i++) {
            if (!(i in a)) {
                print ""
                printerr(sprintf("Array%s is not 1-based or is non-contiguous. "\
                    "Use `printaa` instead.",
                    name == "noname" ? "" : sprintf(" `%s`", name)))
                return
            }
            printf "%s[%s]=%s", name, i, (i<l-1) ? a[i] fs : a[i] "\n"
        }
    } # printa - print a numerically-indexed array

    function printaa(a,  name,fs,l,n,i) {
        name = name ? name : "noname"
        fs = fs ? fs : "; "
        l = length(a)
        n = 1  # keep track of which element we are on

        printf "length(%s)==%i\n", name, l

        for (i in a) {
            printf "%s[%s]=%s", name, i, (n<l) ? a[i] fs : a[i] "\n"
            n++
        }
    } # printaa - the associative array version
'

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_trim_blanks() {
    local in=${1:?missing input file argument}
    # macOS doesn't have 'tac'
    local tac='tac'; [[ $(uname -s) == Darwin ]] && tac='tail -r'
    local tmp
    tmp=$(mktemp /tmp/awkrepl-XXXXXX) || { echo "awkrepl: mktemp failed" >&2; return 1; }
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" RETURN

    # trim spaces from the front; reverse; trim spaces from the front; reverse
    sed -e '1,/^[^[:space:]]/ { /^[[:space:]]*$/d; }' "$in" \
      | $tac \
      | sed -e '1,/^[^[:space:]]/ { /^[[:space:]]*$/d; }' \
      | $tac \
      > "$tmp"

    mv -f "$tmp" "$1"
}

_awkrepl_pretty_print() {
    local src=${1:?missing AWK source file argument}
    local cat='cat'

    local _bat
    _bat=$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    [[ -n "$_bat" ]] && cat="$_bat -l awk -p --tabs=4"

    if ! gawk --pretty-print=- -f "$src" | $cat 2>/dev/null; then
        echo -e "\nERROR parsing AWK source; input was:"
        $cat "$src" 2>/dev/null
    fi
} # _awkrepl_pretty_print

# divide input file $1 into source ($2), data ($3), and args ($4) files
_awkrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa]'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\(ument\)*[Ss]*:*[[:space:]]*'

    # extract arguments
    sed -n \
      -e "s/$argshdr//w $args" \
      "$in"

    # split the input file at the '#DATA' header and write into two files
    sed -n \
      -e "1,/$datahdr/w $src" \
      -e "/$datahdr/,\$w $data" \
      "$in"

    # remove '#DATA' header from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code; trim blanks
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
    _trim_blanks "$src"

    # remove comments and blank lines from source (see #6)
    _sed_in_place -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$src"

    # don't touch if there's any kind of outer brace expression, including
    # implicit '{print}' one like 'NR==…' and '($1 == x && $2 == y) && $3'
    if perl -${DEBUG:+d}ne '
        s/\s+//;                     # strip all whitespace

        /^(                          # at beginning of the line, try to match

          \{          |              # a curly brace, or...
          (BEGIN|END) |              # BEGIN or END, or...

          \(?                        # maybe an open paren
            ( N[FR] | \$\d | \/. )   # NF, NR, field reference, or regex
          \)?                        # maybe a close paren
        )/x && exit;                 # return success if we matched

        exit 1;' "$src"
    then
        # no further processing
        return
    fi

    # otherwise:
    #   - wrap entire source in '{ }' if there's #DATA
    #   - wrap in 'END { … }' if not

    # sed 'i\' and 'a\' expect a newline, so embed that with ANSI-C quoting
    local awkbegin=$'\n{'
    local awkendbegin=$'\nEND {'
    local awkend=$'\n}'

    if [[ -s "$data" ]]; then
        _sed_in_place -e "1i\\$awkbegin" -e "\$a\\$awkend" "$src"
    else
        _sed_in_place -e "1i\\$awkendbegin" -e "\$a\\$awkend" "$src"
    fi
} # _awkrepl_divide

# the tmux subshells need these
export -f _sed_in_place
export -f _awkrepl_divide
export -f _awkrepl_pretty_print

_awkrepl_setup() {
    local replfile=${1:?missing replfile argument}
    local src data args runner formatter helpers cleanup
    src=$(mktemp /tmp/awkrepl-src-XXXXXX)         || { echo "awkrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp /tmp/awkrepl-data-XXXXXX)        || { echo "awkrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp /tmp/awkrepl-args-XXXXXX)        || { echo "awkrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp /tmp/awkrepl-run-XXXXXX)       || { echo "awkrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp /tmp/awkrepl-fmt-XXXXXX)    || { echo "awkrepl: mktemp failed" >&2; return 1; }
    helpers=$(mktemp /tmp/awkrepl-helpers-XXXXXX)  || { echo "awkrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp /tmp/awkrepl-cleanup-XXXXXX)  || { echo "awkrepl: mktemp failed" >&2; return 1; }

    # AWK array helper functions like printa and printaa
    echo "$AWKHELPERS" > "$helpers"

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    # Note: sed's 'w filename' ends at the first space; since these are /tmp
    # mktemp paths they will never contain spaces, but we quote for all other uses.
    local q_replfile q_src q_data q_args q_helpers q_runner q_formatter q_cleanup
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_helpers=$(printf '%q' "$helpers")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _trim_blanks _awkrepl_divide)
_awkrepl_divide $q_replfile $q_src $q_data $q_args
# shellcheck disable=SC2046
_gawk_args=( \$(cat $q_args) )
echo "$(tput setaf 0)# work dir: \$PWD$(tput sgr0)"
echo "$(tput setaf 0)# command:  gawk \${_gawk_args[*]} -f $q_helpers -f $q_src $q_data$(tput sgr0)"
gawk "\${_gawk_args[@]}" -f $q_helpers -f $q_src $q_data
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _awkrepl_pretty_print)
sleep 1
_awkrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_helpers $q_cleanup
CLEANUP

    chmod a+x "$runner" "$formatter" "$cleanup"

    # These globals are read by the caller after _awkrepl_setup returns.
    # shellcheck disable=SC2034
    REPL_REPLFILE="$replfile"   REPL_SRC="$src"         REPL_DATA="$data"
    # shellcheck disable=SC2034
    REPL_ARGS="$args"           REPL_HELPERS="$helpers"  REPL_RUNNER="$runner"
    # shellcheck disable=SC2034
    REPL_FORMATTER="$formatter" REPL_CLEANUP="$cleanup"
    # shellcheck disable=SC2034
    REPL_Q_REPLFILE="$q_replfile" REPL_Q_SRC="$q_src"   REPL_Q_HELPERS="$q_helpers"
    # shellcheck disable=SC2034
    REPL_Q_RUNNER="$q_runner"  REPL_Q_FORMATTER="$q_formatter" REPL_Q_CLEANUP="$q_cleanup"
} # _awkrepl_setup

awkrepl() {
    local replfile="$HOME/.repl.awk"
    test -f "$replfile" || touch "$replfile"
    (( ${TRACE:-} )) && set -x
    _awkrepl_setup "$replfile" || return 1
    tmux new${TMUX:+w} -n 'awkrepl'                              \
      "${EDITOR:-nano}" "$replfile" \;                             \
      split-window    -c "$PWD"                                    \
        "echo $REPL_Q_REPLFILE | entr -c $REPL_Q_RUNNER" \;      \
      split-window -h -c "$PWD"                                    \
        "echo $REPL_Q_SRC | entr -c $REPL_Q_FORMATTER" \;        \
      select-pane -t 1 \;                                          \
      select-pane -t 2 \;                                          \
      select-pane -t 0 \;                                          \
      set-hook 'pane-exited[0]' "run-shell $REPL_Q_CLEANUP" \;   \
      set-hook 'pane-exited[1]' kill-window
      # FIXME: weird, but the 'pane-exited' hooks don't seem to work with the
      # tmux that's in the Docker image (3.1c); maybe disable input to panes
      # 1 and 2 again if I can get this working reliably
}

# allow sourcing for tests without launching the REPL
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && awkrepl "$@"
