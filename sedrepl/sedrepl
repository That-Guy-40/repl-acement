#!/usr/bin/env bash
##
##  sedrepl - a REPL for sed
##
##  Author:   Based on awkrepl by Kevin Ernst <ernstki -at- mail.uc.edu>
##  License:  MIT
##
##  Requirements:
##    - sed (GNU sed or BSD sed)
##    - tmux ≥ 2
##    - entr - http://eradman.com/entrproject/
##    - bat (optional) - https://github.com/sharkdp/bat
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "sedrepl: error at line $LINENO" >&2; exit 1' ERR

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_sedrepl_pretty_print() {
    local src=${1:?missing sed source file argument}
    local cat='cat'
    local _bat
    _bat=$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    # bat has no 'sed' syntax; awk's pattern/action highlighting is the closest
    # built-in match (handles '#' comments and regex literals).
    [[ -n "$_bat" ]] && cat="$_bat -l awk -p --tabs=4"

    # run once: capture stderr; non-zero exit signals a syntax error.
    # avoids double-execution (side effects from 'e', 'w', 'R'/'W' commands).
    local err_output
    if ! err_output=$(sed -n -f "$src" /dev/null 2>&1); then
        printf '\nERROR parsing sed script; input was:\n'
        printf '%s\n---\n' "$err_output"
    fi

    $cat "$src" 2>/dev/null
} # _sedrepl_pretty_print

# divide input file $1 into source ($2), data ($3), and args ($4) files
_sedrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa]'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\(ument\)*[Ss]*:*[[:space:]]*'

    # extract arguments
    sed -n \
      -e "s/$argshdr//w $args" \
      "$in"

    # split the input file at the '#DATA' header and write into two files
    sed -n \
      -e "1,/$datahdr/w $src" \
      -e "/$datahdr/,\$w $data" \
      "$in"

    # remove '#DATA' header from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
} # _sedrepl_divide

# the tmux subshells need these
export -f _sed_in_place
export -f _sedrepl_divide
export -f _sedrepl_pretty_print

_sedrepl_setup() {
    local replfile=${1:?missing replfile argument}
    local src data args runner formatter cleanup
    src=$(mktemp /tmp/sedrepl-src-XXXXXX)         || { echo "sedrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp /tmp/sedrepl-data-XXXXXX)        || { echo "sedrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp /tmp/sedrepl-args-XXXXXX)        || { echo "sedrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp /tmp/sedrepl-run-XXXXXX)       || { echo "sedrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp /tmp/sedrepl-fmt-XXXXXX)    || { echo "sedrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp /tmp/sedrepl-cleanup-XXXXXX)  || { echo "sedrepl: mktemp failed" >&2; return 1; }

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    local q_replfile q_src q_data q_args q_runner q_formatter q_cleanup
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _sedrepl_divide)
_sedrepl_divide $q_replfile $q_src $q_data $q_args
# shellcheck disable=SC2046
_sed_args=( \$(cat $q_args) )
echo "$(tput setaf 0)# work dir: \$PWD$(tput sgr0)"
echo "$(tput setaf 0)# command:  sed \${_sed_args[*]} -f $q_src $q_data$(tput sgr0)"
echo
_bat=\$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
if [[ -n "\$_bat" ]]; then
    "\$_bat" -l awk -p --tabs=4 $q_src 2>/dev/null
else
    cat $q_src
fi
echo
sed "\${_sed_args[@]}" -f $q_src $q_data
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sedrepl_pretty_print)
sleep 1
_sedrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_cleanup
CLEANUP

    chmod a+x "$runner" "$formatter" "$cleanup"

    # These globals are read by the caller after _sedrepl_setup returns.
    # shellcheck disable=SC2034
    REPL_REPLFILE="$replfile"   REPL_SRC="$src"         REPL_DATA="$data"
    # shellcheck disable=SC2034
    REPL_ARGS="$args"           REPL_RUNNER="$runner"   REPL_FORMATTER="$formatter"
    # shellcheck disable=SC2034
    REPL_CLEANUP="$cleanup"
    # shellcheck disable=SC2034
    REPL_Q_REPLFILE="$q_replfile" REPL_Q_SRC="$q_src"   REPL_Q_RUNNER="$q_runner"
    # shellcheck disable=SC2034
    REPL_Q_FORMATTER="$q_formatter" REPL_Q_CLEANUP="$q_cleanup"
} # _sedrepl_setup

sedrepl() {
    local replfile="$HOME/.repl.sed"
    test -f "$replfile" || touch "$replfile"
    (( ${TRACE:-} )) && set -x
    _sedrepl_setup "$replfile" || return 1
    tmux new${TMUX:+w} -n 'sedrepl'                              \
      "${EDITOR:-nano}" "$replfile" \;                             \
      split-window    -c "$PWD"                                    \
        "echo $REPL_Q_REPLFILE | entr -c $REPL_Q_RUNNER" \;      \
      split-window -h -c "$PWD"                                    \
        "echo $REPL_Q_SRC | entr -c $REPL_Q_FORMATTER" \;        \
      select-pane -t 1 \;                                          \
      select-pane -t 2 \;                                          \
      select-pane -t 0 \;                                          \
      set-hook 'pane-exited[0]' "run-shell $REPL_Q_CLEANUP" \;   \
      set-hook 'pane-exited[1]' kill-window
}

# allow sourcing for tests without launching the REPL
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && sedrepl "$@"
