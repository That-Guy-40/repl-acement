#!/usr/bin/env bash
##
##  jqrepl - a REPL for jq
##
##  Based on awkrepl by Kevin Ernst <ernstki -at- mail.uc.edu>
##  License:  MIT
##
##  Requirements:
##    - jq ≥ 1.5
##    - sed (GNU sed or BSD sed; used to split the REPL file)
##    - tmux ≥ 2 (I think)
##    - entr - http://eradman.com/entrproject/
##    - xargs (findutils; used to parse #ARGS)
##    - bat or batcat (optional) - https://github.com/sharkdp/bat
##
set -uo pipefail
[[ "${BASH_SOURCE[0]}" == "${0}" ]] && trap 'echo "jqrepl: error at line $LINENO" >&2; exit 1' ERR

_sed_in_place() {
    if [[ $(uname -s) == Linux ]]; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

_jqrepl_pretty_print() {
    local src=${1:?missing jq source file argument}
    local cat='cat'

    local _bat
    _bat=$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    [[ -n "$_bat" ]] && cat="$_bat -l jq -p --tabs=4"

    [[ -s "$src" ]] && $cat "$src" 2>/dev/null
} # _jqrepl_pretty_print

# divide input file $1 into source ($2), data ($3), and args ($4) files
_jqrepl_divide() {
    local in=${1:?missing input file argument}
    local src=${2:?missing source output file argument}
    local data=${3:?missing data output file argument}
    local args=${4:?missing args output file argument}
    # Headers (case-insensitive): '#DATA' must be alone on its line, and
    # '#ARGS' (or #ARG / #ARGUMENT(S)) must be followed by nothing or by options
    # starting with '-'. So comments like '# Database…', '# data comes from…'
    # or '# Args are cool' stay comments. In argshdr, \3 is the options part.
    local datahdr='^#[[:space:]]*[Dd][Aa][Tt][Aa][:[:space:]]*$'
    local argshdr='^#[[:space:]]*[Aa][Rr][Gg]\([Uu][Mm][Ee][Nn][Tt]\)\{0,1\}[Ss]\{0,1\}\([:[:space:]]\{1,\}\(-.*\)\)\{0,1\}[:[:space:]]*$'

    # split the input file at the first '#DATA' header, which may be line 1
    # (a file that is only data): the source is everything before it, the data
    # everything after it. (A '1,/re/' range can't do this: it only looks for
    # its end from line 2, so a header on line 1 used to send the data into the
    # source as well.) The '{ :a n p ba }' loop prints every line after the
    # first header and is portable (GNU '0,/re/' is not).
    sed -e "/$datahdr/,\$d" "$in" > "$src"
    sed -n -e "/$datahdr/{" -e ':a' -e 'n' -e 'p' -e 'ba' -e '}' "$in" > "$data"

    # extract the #ARGS options from the program section only: everything
    # after '#DATA' is data, so an '#ARGS' line there is just another data row
    sed -n -e "s/$argshdr/\3/p" "$src" > "$args"

    # remove any further '#DATA' lines from the data file
    _sed_in_place -e "/$datahdr/d" "$data"

    # remove '#DATA' and '#ARGS' headers from source code
    _sed_in_place -e "/$datahdr/d" -e "/$argshdr/d" "$src"
} # _jqrepl_divide

# _repl_parse_args FILE — print the #ARGS tokens NUL-separated, honoring shell
# quotes (so a value may contain spaces) but WITHOUT globbing or any variable/
# command expansion. xargs only splits and unquotes; it never expands, so a
# literal '*' stays '*'.
# On an unmatched quote it warns on stderr (shown in the runner pane) and
# splits on whitespace instead, keeping the quote characters literally.
_repl_parse_args() {
    local f=${1:?missing args file}
    local -a w
    grep -q '[^[:space:]]' "$f" 2>/dev/null || return 0   # nothing but whitespace
    if xargs true < "$f" >/dev/null 2>&1; then
        xargs printf '%s\0' < "$f"
    else
        # xargs rejects an unmatched quote (e.g. "it's") and would drop every
        # argument. Say so, and fall back to splitting on whitespace with the
        # quote characters kept as typed (still no globbing: read never globs).
        echo "warning: #ARGS has an unmatched quote; splitting it on whitespace instead" >&2
        while read -r -a w || (( ${#w[@]} )); do
            (( ${#w[@]} )) && printf '%s\0' "${w[@]}"
        done < "$f"
    fi
}


_jqrepl_setup() {
    local replfile=${1:?missing replfile argument}
    local src data args runner formatter cleanup editpane
    src=$(mktemp "${TMPDIR:-/tmp}/jqrepl-src-XXXXXX")         || { echo "jqrepl: mktemp failed" >&2; return 1; }
    data=$(mktemp "${TMPDIR:-/tmp}/jqrepl-data-XXXXXX")        || { echo "jqrepl: mktemp failed" >&2; return 1; }
    args=$(mktemp "${TMPDIR:-/tmp}/jqrepl-args-XXXXXX")        || { echo "jqrepl: mktemp failed" >&2; return 1; }
    runner=$(mktemp "${TMPDIR:-/tmp}/jqrepl-run-XXXXXX")       || { echo "jqrepl: mktemp failed" >&2; return 1; }
    formatter=$(mktemp "${TMPDIR:-/tmp}/jqrepl-fmt-XXXXXX")    || { echo "jqrepl: mktemp failed" >&2; return 1; }
    cleanup=$(mktemp "${TMPDIR:-/tmp}/jqrepl-cleanup-XXXXXX")  || { echo "jqrepl: mktemp failed" >&2; return 1; }
    editpane=$(mktemp "${TMPDIR:-/tmp}/jqrepl-edit-XXXXXX")     || { echo "jqrepl: mktemp failed" >&2; return 1; }

    # shell-safe (printf '%q') versions of all paths for embedding in generated
    # scripts and tmux commands — prevents word-splitting, glob expansion, and
    # single-quote injection when paths contain spaces or special characters.
    local q_replfile q_src q_data q_args q_runner q_formatter q_cleanup q_editpane
    q_replfile=$(printf '%q' "$replfile")
    q_src=$(printf '%q' "$src")
    q_data=$(printf '%q' "$data")
    q_args=$(printf '%q' "$args")
    q_runner=$(printf '%q' "$runner")
    q_formatter=$(printf '%q' "$formatter")
    q_cleanup=$(printf '%q' "$cleanup")
    q_editpane=$(printf '%q' "$editpane")

    # Heredoc delimiter is unquoted so $(declare -f ...) and $(tput ...) expand
    # NOW (generation time). \$VAR and \${ARRAY[@]} are deferred to run time.
    # without #DATA, pass -n (null input) so jq doesn't block on stdin —
    # analogous to awkrepl's END{} wrapping for filterless runs
    cat > "$runner" <<RUNNER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _sed_in_place _jqrepl_divide _repl_parse_args)
_jqrepl_divide $q_replfile $q_src $q_data $q_args
# like yqrepl: nothing to run if the program is only comments and blank lines
if grep -v '^[[:space:]]*#' $q_src | grep -q '[^[:space:]]'; then
    _jq_args=()
    while IFS= read -r -d '' _a; do _jq_args+=( "\$_a" ); done < <(_repl_parse_args $q_args)
    echo "$(tput dim 2>/dev/null)# work dir: \$PWD$(tput sgr0)"
    if [[ -s $q_data ]]; then
        echo "$(tput dim 2>/dev/null)# command:  jq \${_jq_args[*]} -f $q_src $q_data$(tput sgr0)"
    else
        echo "$(tput dim 2>/dev/null)# command:  jq -n \${_jq_args[*]} -f $q_src$(tput sgr0)"
    fi
    echo
    _bat=\$(type -p bat 2>/dev/null || type -p batcat 2>/dev/null || true)
    if [[ -n "\$_bat" ]]; then
        "\$_bat" -l jq -p --tabs=4 $q_src 2>/dev/null
    else
        cat $q_src
    fi
    echo
    if [[ -s $q_data ]]; then
        jq "\${_jq_args[@]}" -f $q_src $q_data
    else
        jq -n "\${_jq_args[@]}" -f $q_src
    fi
fi
RUNNER

    cat > "$formatter" <<FORMATTER
#!/usr/bin/env bash
set -uo pipefail
$(declare -f _jqrepl_pretty_print)
sleep 1
_jqrepl_pretty_print $q_src
FORMATTER

    cat > "$cleanup" <<CLEANUP
#!/usr/bin/env bash
rm -f $q_src $q_data $q_args $q_runner $q_formatter $q_editpane $q_cleanup
CLEANUP

    # Pane 0 runs this wrapper rather than the editor itself. When the editor
    # exits, or the window is killed (SIGHUP), it removes the temp files and
    # closes this REPL's window, found from its own pane ($TMUX_PANE), so it
    # never touches other windows when the REPL runs inside an existing tmux
    # session. (tmux 'pane-exited' hooks can't be scoped like that: tmux
    # resolves them against the session's current window, whichever pane
    # exited.) $EDITOR is run by the shell, as git does, so it may carry
    # flags (e.g. 'code -w' or 'emacsclient -t'). The editor runs as a child
    # the wrapper waits on, so a hangup (the window killed) is handled at
    # once: bash defers a trap until a foreground child exits, and the
    # killed window's editor might never exit. '<&0' keeps the pane's
    # terminal as its input (a background command would get /dev/null).
    cat > "$editpane" <<EDITPANE
#!/usr/bin/env bash
_editor=
_done() {
    trap - HUP TERM
    [[ -n "\$_editor" ]] && kill "\$_editor" 2>/dev/null
    $q_cleanup
    [[ -n "\${TMUX_PANE:-}" ]] && tmux kill-window -t "\$TMUX_PANE" 2>/dev/null
    exit 0
}
trap _done HUP TERM
trap '' INT QUIT
${EDITOR:-nano} $q_replfile <&0 &
_editor=\$!
wait "\$_editor"
_editor=
_done
EDITPANE

    chmod a+x "$runner" "$formatter" "$cleanup" "$editpane"

    # These globals are read by the caller after _jqrepl_setup returns.
    # shellcheck disable=SC2034
    REPL_REPLFILE="$replfile"   REPL_SRC="$src"         REPL_DATA="$data"
    # shellcheck disable=SC2034
    REPL_ARGS="$args"           REPL_RUNNER="$runner"   REPL_FORMATTER="$formatter"
    # shellcheck disable=SC2034
    REPL_CLEANUP="$cleanup" REPL_EDITPANE="$editpane"
    # shellcheck disable=SC2034
    REPL_Q_REPLFILE="$q_replfile" REPL_Q_SRC="$q_src"   REPL_Q_RUNNER="$q_runner"
    # shellcheck disable=SC2034
    REPL_Q_FORMATTER="$q_formatter" REPL_Q_CLEANUP="$q_cleanup" REPL_Q_EDITPANE="$q_editpane"
} # _jqrepl_setup

jqrepl() {
    local replfile="$HOME/.repl.jq"
    test -f "$replfile" || touch "$replfile"
    (( ${TRACE:-} )) && set -x
    _jqrepl_setup "$replfile" || return 1
    # if a runner/formatter pane's entr exits, close this REPL's window too
    # (the editor pane's wrapper then removes the temp files)
    # shellcheck disable=SC2016  # $TMUX_PANE is expanded later, by the pane's shell
    local close='; tmux kill-window -t "$TMUX_PANE"'
    # A new session (not nested in tmux) gets a known name, so the cleanup
    # below can tell "the session ended" from "the client only detached".
    local session="jqrepl-$$"
    local -a launch=(new-session -s "$session")
    if [[ -n "${TMUX:-}" ]]; then launch=(new-window); fi
    tmux "${launch[@]}" -n 'jqrepl'                                \
      "$REPL_Q_EDITPANE" \;                                        \
      split-window    -c "$PWD"                                    \
        "echo $REPL_Q_REPLFILE | entr -c $REPL_Q_RUNNER$close" \;  \
      split-window -h -c "$PWD"                                    \
        "echo $REPL_Q_SRC | entr -c $REPL_Q_FORMATTER$close" \;    \
      select-pane -t 1 \;                                          \
      select-pane -t 2 \;                                          \
      select-pane -t 0

    # Backstop cleanup. The editor pane's wrapper removes the temp files when
    # the editor exits or the window is killed; this covers the rare case it
    # can't (e.g. its process was SIGKILLed). A new session's 'tmux
    # new-session' returns both when the session ends and when the client
    # merely detaches, so only clean up once our named session is really
    # gone: a detached session still needs these files. In the nested case
    # ('new-window' returns at once) the window is still live, so cleanup is
    # left to the wrapper.
    if [[ -z "${TMUX:-}" ]] && ! tmux has-session -t "=$session" 2>/dev/null; then
        rm -f "$REPL_SRC" "$REPL_DATA" "$REPL_ARGS" "$REPL_RUNNER" \
              "$REPL_FORMATTER" "$REPL_CLEANUP" "$REPL_EDITPANE"
    fi
}

# allow sourcing for tests without launching the REPL
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then jqrepl "$@"; fi
