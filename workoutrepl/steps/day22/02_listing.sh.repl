# day 22 · piece 2 of 5 — listing.txt: tar -t, sorted
#
# -t lists members without extracting; -z for gzip, -f for the file. Sort with
# LC_ALL=C and write listing.txt — directories keep their trailing slash.
#DAY 22
#FILE listing.sh
#RUN bash ./listing.sh; echo '--- listing.txt:'; cat listing.txt
#!/usr/bin/env bash
tar -tzf site.tar.gz                     # ← sort it, into listing.txt
