# day 8 · piece 1 of 6 — errors-count.txt: a count per file, with grep alone
#
# -r recurses, -c counts matching LINES per file, --include='*.log' filters by name,
# and -w makes ERROR a whole word so ERRORS and Error do not count. The skeleton is
# close but counts in every file (notes.txt too) and counts the wrong words. Fix the
# flags, then send the sorted result into errors-count.txt (LC_ALL=C sort: byte order).
#DAY 8
#FILE errors-count.sh
#RUN bash ./errors-count.sh; echo '--- errors-count.txt:'; cat errors-count.txt
#!/usr/bin/env bash
grep -rc ERROR logs          # ← every file, loose match, on the screen: fix all three
