# day 9 · piece 3 of 4 — names.txt: a line range
#
# `-n` turns off automatic printing; an address range `3,5` with the `p` command prints
# only those lines. The skeleton prints everything.
#DAY 9
#FILE names.sh
#RUN bash ./names.sh; echo '--- names.txt:'; cat names.txt
#!/usr/bin/env bash
sed '' hosts.txt             # ← -n plus an address range and p; write names.txt
