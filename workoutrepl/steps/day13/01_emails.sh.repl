# day 13 · piece 1 of 6 — emails.txt: LINES containing a plausible address
#
# A bracket class for the user part, one for the host, a literal dot (\.) and a TLD of
# 2+ letters with {2,}. No -o: the lines are wanted. bad@@double.at must not count —
# a second grep -v '@@' is an honest way to say so. The skeleton matches any @.
#DAY 13
#FILE emails.sh
#RUN bash ./emails.sh; echo '--- emails.txt:'; cat emails.txt
#!/usr/bin/env bash
grep '@' input.txt           # ← the user@host.tld shape with -E; write emails.txt
